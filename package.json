{
  "name": "gra-ui",
  "version": "0.1.9",
  "description": "React components composed with shadcn/ui, for interfaces with unnecessary personality.",
  "packageManager": "pnpm@10.26.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "build:docs": "pnpm --filter gra-docs build",
    "check": "pnpm lint && pnpm typecheck && pnpm typecheck:docs",
    "dev:docs": "pnpm --filter gra-docs dev",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "typecheck:docs": "pnpm run build && pnpm --filter gra-docs typecheck",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregory-artaud/gra-ui.git"
  },
  "homepage": "https://ui.gra.sh/",
  "license": "MIT"
}
